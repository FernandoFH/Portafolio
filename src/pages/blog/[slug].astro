---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { socials } from '../../data/profile.ts';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  return allPosts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('es-AR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
const selfUrl = `https://fernandoh.com/blog/${post.id}/`;
const canonicalUrl = post.data.canonicalUrl ?? selfUrl;

const platformInfo: Record<string, { label: string; href: string }> = {
  medium:   { label: 'Medium',   href: socials.medium },
  devto:    { label: 'Dev.to',   href: socials.devto },
  substack: { label: 'Substack', href: socials.substack },
};
const pub = post.data.platform ? platformInfo[post.data.platform] : undefined;
---
<BaseLayout title={post.data.title} description={post.data.description} canonicalUrl={canonicalUrl} ogUrl={selfUrl} ogType="article">
  <Nav slot="nav" />
  <article>
    <header>
      {post.data.status === 'draft' && <span class="draft-badge">DRAFT</span>}
      <h1 transition:name={`post-title-${post.id}`}>{post.data.title}</h1>
      <div class="meta">
        <time datetime={post.data.date.toISOString()}>{dateStr}</time>
        <span>·</span>
        {pub && <a class="dest" href={post.data.status === 'published' && post.data.canonicalUrl ? post.data.canonicalUrl : pub.href} target="_blank" rel="noopener noreferrer">{pub.label} ↗</a>}
      </div>
      <p class="desc">{post.data.description}</p>
      <ul class="tags">
        {post.data.tags.map(t => <li>#{t}</li>)}
      </ul>
    </header>
    <div class="content">
      <Content />
    </div>
    <footer class="post-footer">
      <a href="/blog">← Volver al blog</a>
    </footer>
  </article>
  <Footer slot="footer" />
</BaseLayout>
<style>
  .draft-badge {
    display: inline-block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.7rem;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }
  h1 { font-size: clamp(1.6rem, 4vw, 2.25rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; margin-bottom: 0.6rem; }
  .meta { display: flex; gap: 0.5rem; color: var(--color-text); opacity: 0.6; font-size: 0.8rem; margin-bottom: 0.75rem; }
  .desc { color: var(--color-muted); margin-bottom: 1rem; }
  .tags { display: flex; gap: 0.6rem; list-style: none; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .tags li { color: var(--color-muted); font-size: 0.75rem; font-family: var(--font-mono); }
  .content { border-top: 1px solid var(--color-border); padding-top: 2rem; }
  .content :global(h2) { font-size: 1.35rem; margin: 2rem 0 0.6rem; }
  .content :global(h3) { font-size: 1.1rem; margin: 1.5rem 0 0.4rem; }
  .content :global(ul), .content :global(ol) { padding-left: 1.5rem; margin-bottom: 1rem; }
  .content :global(a) { text-decoration: underline; text-underline-offset: 3px; }
  .content :global(blockquote) { border-left: 3px solid var(--color-border); padding-left: 1rem; color: var(--color-muted); margin: 1rem 0; }
  .content :global(img) { max-width: 100%; height: auto; border-radius: 8px; }
  .content :global(hr) { border: 0; border-top: 1px solid var(--color-border); margin: 2rem 0; }
  .content :global(table) { border-collapse: collapse; margin: 1rem 0; font-size: 0.9rem; }
  .content :global(th), .content :global(td) { border: 1px solid var(--color-border); padding: 0.4rem 0.75rem; }
  .post-footer { margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  .post-footer a { color: var(--color-muted); font-size: 0.9rem; }
</style>
