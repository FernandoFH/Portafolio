---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const allResearch = await getCollection('research');
const published = allResearch
  .filter(r => r.data.status === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const typeLabel: Record<string, string> = {
  paper: 'Paper',
  article: 'Article',
  note: 'Note',
  thesis: 'Thesis',
};
---
<BaseLayout title="My Research" description="Research notes, papers, and articles on SRE, distributed systems, and computer science.">
  <Nav slot="nav" />
  <h1>My Research</h1>
  <p class="subtitle">{published.length} {published.length === 1 ? 'entry' : 'entries'}</p>
  <ul class="research-list">
    {published.map(r => (
      <li class="research-item">
        <div class="meta">
          <span class="type">{typeLabel[r.data.type]}</span>
          <span class="date">{r.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
        </div>
        <h2>
          {r.data.url
            ? <a href={r.data.url} target="_blank" rel="noopener noreferrer">{r.data.title}</a>
            : r.data.title
          }
        </h2>
        <p class="description">{r.data.description}</p>
        <div class="tags">
          {r.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </li>
    ))}
  </ul>
  <Footer slot="footer" />
</BaseLayout>
<style>
  h1 { font-size: 1.8rem; margin-bottom: 0.25rem; }
  .subtitle { color: var(--color-muted); font-size: 0.85rem; margin-bottom: 2.5rem; }

  .research-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .research-item {
    border-left: 2px solid var(--color-border);
    padding-left: 1.25rem;
    transition: border-color 0.2s;
  }
  .research-item:hover { border-color: var(--color-accent); }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .type {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--color-accent);
    color: var(--color-bg);
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
  }

  .date { font-size: 0.8rem; color: var(--color-muted); }

  h2 { font-size: 1.05rem; font-weight: 600; margin: 0 0 0.4rem; }
  h2 a { color: var(--color-text); }
  h2 a:hover { color: var(--color-accent); text-decoration: none; }

  .description { font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; margin-bottom: 0.6rem; }

  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag {
    font-size: 0.72rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
</style>
