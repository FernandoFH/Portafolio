---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { socials } from '../data/profile.ts';

const experience = [
  {
    role: 'Site Reliability Engineer',
    company: 'Trektel',
    period: 'jun. 2023 – actualidad',
    location: 'Buenos Aires, Argentina',
    current: true,
    bullets: [],
  },
  {
    role: 'Site Reliability Engineer',
    company: 'Cervecería y Maltería Quilmes',
    period: 'jun. 2022 – jun. 2023 · 1 año 1 mes',
    location: 'Buenos Aires, Argentina',
    current: false,
    bullets: [
      'Implementación y mantenimiento de pipelines CI/CD.',
      'Gestión y optimización de costos de infraestructura en Azure.',
      'Implementación de soluciones de monitoreo de infraestructura y APM.',
      'Automatización de procesos e infraestructura con Python, Terraform y Ansible.',
      'Colaboración con equipos de desarrollo para integrar feedback y alinear estrategias.',
    ],
  },
  {
    role: 'Production Engineer',
    company: 'Metrotel Argentina',
    period: 'abr. 2021 – nov. 2021 · 8 meses',
    location: 'Buenos Aires, Argentina',
    current: false,
    bullets: [
      'Automatización, monitoreo y despliegue productivo de soluciones internas.',
    ],
  },
  {
    role: 'Production Engineer',
    company: 'Telefónica Argentina',
    period: 'abr. 2016 – abr. 2021 · 5 años 1 mes',
    location: 'Argentina',
    current: false,
    bullets: [
      'Diseño, planificación e implementación de productos y servicios de valor agregado.',
      'Análisis funcional y técnico de requerimientos del área de marketing.',
    ],
  },
  {
    role: 'Consultor Siebel',
    company: 'OneInfo Consulting',
    period: 'jun. 2015 – abr. 2016 · 11 meses',
    location: 'Buenos Aires, Argentina',
    current: false,
    bullets: [
      'Configuración y desarrollo en Oracle Siebel 8.0/8.1 (EAI/EIM).',
      'Integraciones legacy vía WebServices y procesos batch/online.',
      'PL/SQL Oracle. Documentación técnica/funcional.',
      'Fábrica de Software Siebel asignada a Telecom Argentina.',
    ],
  },
  {
    role: 'Support Engineer',
    company: 'Corporación Digitel',
    period: 'may. 2013 – may. 2015 · 2 años 1 mes',
    location: 'Caracas, Venezuela',
    current: false,
    bullets: [
      'Soporte y troubleshooting de procesos de facturación (Comverse RTBS).',
      'Integración, configuración y desarrollo de nuevos servicios en la red GSM/LTE prepago.',
    ],
  },
  {
    role: 'Network Engineer',
    company: 'Ericsson Telecommunications',
    period: 'abr. 2012 – may. 2013 · 1 año 2 meses',
    location: 'CORE Movistar, Venezuela',
    current: false,
    bullets: [
      'Monitoreo y gestión de soluciones corporativas de Telefónica (Frame Relay, MPLS, TDM, CPA).',
    ],
  },
  {
    role: 'Docente Contratado',
    company: 'UNEFA',
    period: 'sept. 2010 – jul. 2011 · 11 meses',
    location: 'San Tomé, Venezuela',
    current: false,
    bullets: ['Física I y II.'],
  },
];
---
<BaseLayout title="Sobre Mí">
  <Nav slot="nav" />
  <section class="about">

    <h1>Sobre Mí</h1>
    <p>
      Ingeniero de telecomunicaciones con foco en Site Reliability Engineering (SRE)
      y research financiero. Construyo sistemas distribuidos confiables y escribo
      sobre lo que aprendo en el camino.
    </p>

    <h2>Áreas</h2>
    <ul class="areas">
      <li><strong>SRE:</strong> Observabilidad, Kubernetes, automatización de operaciones.</li>
      <li><strong>Telecom:</strong> Redes, protocolos, infraestructura de telecomunicaciones.</li>
      <li><strong>Financial Research:</strong> Análisis cuantitativo, Bitcoin, mercados.</li>
    </ul>

    <h2>Publicaciones</h2>
    <ul class="areas">
      <li><a href={socials.medium} target="_blank" rel="noopener">Medium</a> — SRE · C++ · TensorFlow · Golang</li>
      <li><a href={socials.devto} target="_blank" rel="noopener">Dev.to</a> — Papers Dev To · Quantum · AI Infrastructure · Rust en Español</li>
      <li><a href={socials.substack} target="_blank" rel="noopener">Substack</a> — Ceiba Research · Coporo Game Studio · Japones Step By Step</li>
    </ul>

    <h2>Experiencia</h2>
    <ol class="timeline">
      {experience.map((job) => (
        <li class="entry">
          <div class="node">
            {job.current && <span class="pulse" />}
          </div>
          <div class="body">
            <span class="role">{job.role}</span>
            <span class="company">{job.company}</span>
            <span class="meta">{job.period} · {job.location}</span>
            {job.bullets.length > 0 && (
              <ul class="bullets">
                {job.bullets.map(b => <li>{b}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .about { max-width: 600px; }

  h1 { font-size: 1.8rem; margin-bottom: 1.5rem; }

  h2 {
    font-size: 0.75rem;
    margin: 2rem 0 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  p, .areas li { color: var(--color-muted); }
  .areas { padding-left: 1.25rem; }
  .areas li { margin-bottom: 0.4rem; }
  strong { color: var(--color-text); }

  /* ── Timeline ───────────────────────────── */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 6px;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
  }

  .entry {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 2rem;
    position: relative;
  }

  .entry:last-child { padding-bottom: 0; }

  /* dot */
  .node {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid var(--color-highlight);
    background: var(--color-bg);
    margin-top: 4px;
    position: relative;
    z-index: 1;
  }

  /* pulsing dot for current job */
  .pulse {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--color-highlight);
    opacity: 0.4;
    animation: ring 2.4s ease-out infinite;
  }

  @keyframes ring {
    0%   { transform: scale(1);   opacity: 0.4; }
    100% { transform: scale(2.2); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse { animation: none; opacity: 0.3; }
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 0;
  }

  .role {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .company {
    font-size: 0.8rem;
    color: var(--color-highlight);
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
  }
  .company::before { content: '// '; opacity: 0.7; }

  .meta {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    margin-bottom: 0.25rem;
  }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bullets li {
    font-size: 0.82rem;
    color: var(--color-muted);
    padding-left: 0.75rem;
    position: relative;
  }

  .bullets li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-border);
  }
</style>
