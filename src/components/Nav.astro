---
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'Sobre Mí' },
];
const current = Astro.url.pathname;
---
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-brand">fh</a>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={[{ active: current === href || (href !== '/' && current.startsWith(href)) }]}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
<style>
  nav {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .nav-brand:hover { text-decoration: none; color: var(--color-accent); }
  ul { display: flex; gap: 1.5rem; list-style: none; }
  a { color: var(--color-muted); font-size: 0.9rem; }
  a:hover, a.active { color: var(--color-text); text-decoration: none; }
</style>
