---
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/portfolio', label: 'Portfolio' },
  { href: '/about', label: 'Sobre Mí' },
];
const current = Astro.url.pathname;
---
<nav>
  <div class="nav-inner">
    <a href="/" class="nav-brand">fh</a>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} class:list={[{ active: current === href || (href !== '/' && current.startsWith(href)) }]}>
            {label}
          </a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" aria-label="Toggle theme" title="Toggle dark/light mode">
      <span class="icon-dark">◐</span>
    </button>
  </div>
</nav>
<style>
  nav {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 1.5rem;
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-brand {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .nav-brand:hover { text-decoration: none; color: var(--color-accent); }
  ul { display: flex; gap: 1.5rem; list-style: none; }
  a { color: var(--color-muted); font-size: 0.9rem; }
  a:hover, a.active { color: var(--color-text); text-decoration: none; }
  #theme-toggle {
    background: none;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    cursor: pointer;
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-size: 1rem;
    line-height: 1;
    transition: color 0.2s, border-color 0.2s;
    margin-left: auto;
  }
  #theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }
</style>
<script>
  const toggle = document.getElementById('theme-toggle');
  const html = document.documentElement;
  const saved = localStorage.getItem('theme');
  if (saved === 'light') html.classList.add('light');
  toggle?.addEventListener('click', () => {
    html.classList.toggle('light');
    localStorage.setItem('theme', html.classList.contains('light') ? 'light' : 'dark');
  });
</script>
