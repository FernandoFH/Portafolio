---
interface Props {
  title: string;
  description: string;
  type: 'github' | 'website';
  url: string;
  tech: string[];
}
const { title, description, type, url, tech } = Astro.props;
const githubSvg = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12z"/></svg>`;
const websiteSvg = `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;
---
<article class="project-card">
  <div class="card-header">
    <span class="icon"><Fragment set:html={type === 'github' ? githubSvg : websiteSvg} /></span>
    <h2><a href={url} target="_blank" rel="noopener noreferrer">{title}</a></h2>
  </div>
  <p>{description}</p>
  <ul class="tech">
    {tech.map(t => <li>{t}</li>)}
  </ul>
</article>
<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s;
  }
  .project-card:hover { border-color: var(--color-accent); }
  .card-header { display: flex; align-items: center; gap: 0.5rem; }
  .icon { display: flex; color: var(--color-muted); flex-shrink: 0; }
  h2 { font-size: 1rem; }
  h2 a { color: var(--color-text); }
  h2 a:hover { color: var(--color-accent); text-decoration: none; }
  p { color: var(--color-muted); font-size: 0.85rem; flex: 1; }
  .tech { display: flex; gap: 0.4rem; list-style: none; flex-wrap: wrap; }
  .tech li {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.72rem;
    padding: 0.15em 0.5em;
    border-radius: 3px;
    font-family: var(--font-mono);
  }
</style>
