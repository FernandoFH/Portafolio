---
interface Props {
  title: string;
  description: string;
  type: 'github' | 'website';
  url: string;
  tech: string[];
}
const { title, description, type, url, tech } = Astro.props;
const CDN = 'https://cdn.simpleicons.org';
const iconSlug = type === 'github' ? 'github' : 'firefoxbrowser';
---
<article class="project-card">
  <div class="card-header">
    <img src={`${CDN}/${iconSlug}/888888`} alt={type} width="18" height="18" loading="lazy" />
    <h2><a href={url} target="_blank" rel="noopener noreferrer">{title}</a></h2>
  </div>
  <p>{description}</p>
  <ul class="tech">
    {tech.map(t => <li>{t}</li>)}
  </ul>
</article>
<style>
  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: border-color 0.2s;
  }
  .project-card:hover { border-color: var(--color-accent); }
  .card-header { display: flex; align-items: center; gap: 0.5rem; }
  h2 { font-size: 1rem; }
  h2 a { color: var(--color-text); }
  h2 a:hover { color: var(--color-accent); text-decoration: none; }
  p { color: var(--color-muted); font-size: 0.85rem; flex: 1; }
  .tech { display: flex; gap: 0.4rem; list-style: none; flex-wrap: wrap; }
  .tech li {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.72rem;
    padding: 0.15em 0.5em;
    border-radius: 3px;
    font-family: var(--font-mono);
  }
</style>
