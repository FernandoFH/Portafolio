---
import { socials } from '../data/profile.ts';

interface Props {
  title: string;
  date: Date;
  description: string;
  slug: string;
  tags: string[];
  status: 'draft' | 'published';
  platform?: 'medium' | 'devto' | 'substack';
  canonicalUrl?: string;
}
const { title, date, description, slug, tags, status, platform, canonicalUrl } = Astro.props;
const dateStr = date.toLocaleDateString('es-AR', { year: 'numeric', month: 'short', day: 'numeric' });

const platformInfo = {
  medium:   { label: 'Medium',   href: socials.medium },
  devto:    { label: 'Dev.to',   href: socials.devto },
  substack: { label: 'Substack', href: socials.substack },
};
const pub = platform ? platformInfo[platform] : undefined;
const localHref = `/blog/${slug}`;
---
<article class:list={['post-card', { draft: status === 'draft' }]}>
  <div class="meta">
    <time datetime={date.toISOString()}>{dateStr}</time>
    {pub && (
      <a class="dest" href={canonicalUrl ?? pub.href} target="_blank" rel="noopener noreferrer">{pub.label} ↗</a>
    )}
    {status === 'draft' && <span class="badge">draft</span>}
  </div>
  <h2 transition:name={`post-title-${slug}`}>
    <a href={localHref}>{title}</a>
  </h2>
  <p>{description}</p>
  <ul class="tags">
    {tags.map(t => <li>#{t}</li>)}
  </ul>
</article>
<style>
  .post-card {
    padding: 1.6rem 0;
  }
  .post-card + .post-card { border-top: 1px solid var(--color-border); }
  .post-card.draft { opacity: 0.65; }
  .post-card.draft:hover { opacity: 1; }
  .meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }
  time, .dest { color: var(--color-muted); font-size: 0.8rem; }
  .badge {
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.7rem;
    padding: 0.1em 0.5em;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  h2 { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.4rem; }
  h2 a { color: var(--color-text); }
  h2 a:hover { text-decoration: underline; text-underline-offset: 4px; }
  p { color: var(--color-muted); font-size: 0.92rem; margin-bottom: 0.6rem; }
  .tags {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    flex-wrap: wrap;
  }
  .tags li { color: var(--color-muted); font-size: 0.75rem; font-family: var(--font-mono); }
</style>
